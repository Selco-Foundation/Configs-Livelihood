{
  "key": "amc-report",
  "config": {
    "pageSize": "A4",
    "pageMargins": [
      28,
      28,
      28,
      28
    ],
    "defaultStyle": {
      "fontSize": 9
    },
    "content": [
      {
        "text": "AMC VISIT REPORT",
        "style": "title"
      },
      {
        "text": "Placeholder layout, to be replaced by the client's format",
        "style": "note"
      },
      {
        "table": {
          "widths": [
            "18%",
            "32%",
            "18%",
            "32%"
          ],
          "body": [
            [
              {
                "text": "Report status",
                "style": "label"
              },
              {
                "text": "{{report_status}}",
                "style": "value"
              },
              {
                "text": "Report ID",
                "style": "label"
              },
              {
                "text": "{{report_id}}",
                "style": "value"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "text": "End user and AMC",
        "style": "sectionHeader"
      },
      {
        "table": {
          "widths": [
            "18%",
            "32%",
            "18%",
            "32%"
          ],
          "body": [
            [
              {
                "text": "End user",
                "style": "label"
              },
              {
                "text": "{{end_user_name}}",
                "style": "value"
              },
              {
                "text": "Phone",
                "style": "label"
              },
              {
                "text": "{{end_user_phone}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "State",
                "style": "label"
              },
              {
                "text": "{{state}}",
                "style": "value"
              },
              {
                "text": "District",
                "style": "label"
              },
              {
                "text": "{{district}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "Block",
                "style": "label"
              },
              {
                "text": "{{block}}",
                "style": "value"
              },
              {
                "text": "Project",
                "style": "label"
              },
              {
                "text": "{{project_name}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "Vendor",
                "style": "label"
              },
              {
                "text": "{{vendor_name}}",
                "style": "value"
              },
              {
                "text": "Field staff",
                "style": "label"
              },
              {
                "text": "{{field_staff_name}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "AMC visit",
                "style": "label"
              },
              {
                "text": "{{amc_number}}",
                "style": "value"
              },
              {
                "text": "Scheduled date",
                "style": "label"
              },
              {
                "text": "{{scheduled_date}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "AMC start",
                "style": "label"
              },
              {
                "text": "{{amc_start_date}}",
                "style": "value"
              },
              {
                "text": "AMC end",
                "style": "label"
              },
              {
                "text": "{{amc_end_date}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "First submitted",
                "style": "label"
              },
              {
                "text": "{{first_submission_date}}",
                "style": "value"
              },
              {
                "text": "Last submitted",
                "style": "label"
              },
              {
                "text": "{{latest_submission_date}}",
                "style": "value"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "text": "System status",
        "style": "sectionHeader"
      },
      {
        "table": {
          "widths": [
            "18%",
            "32%",
            "18%",
            "32%"
          ],
          "body": [
            [
              {
                "text": "System in use",
                "style": "label"
              },
              {
                "text": "{{system_in_use}}",
                "style": "value"
              },
              {
                "text": "System functional",
                "style": "label"
              },
              {
                "text": "{{system_functional}}",
                "style": "value"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "text": "Report answers",
        "style": "sectionHeader"
      },
      {
        "table": {
          "headerRows": 1,
          "widths": [
            "45%",
            "55%"
          ],
          "body": [
            [
              {
                "text": "Question",
                "style": "tableHeader"
              },
              {
                "text": "Answer",
                "style": "tableHeader"
              }
            ],
            "{{#responses}}[{\"text\":\"{{label}}\", \"style\":\"value\"}, {\"text\":\"{{value}}\", \"style\":\"value\"}]{{/responses}}"
          ]
        },
        "layout": {}
      },
      {
        "text": "Readings checked for auto-approval",
        "style": "sectionHeader"
      },
      {
        "table": {
          "headerRows": 1,
          "widths": [
            "40%",
            "20%",
            "25%",
            "15%"
          ],
          "body": [
            [
              {
                "text": "Parameter",
                "style": "tableHeader"
              },
              {
                "text": "Reading",
                "style": "tableHeader"
              },
              {
                "text": "Accepted",
                "style": "tableHeader"
              },
              {
                "text": "Result",
                "style": "tableHeader"
              }
            ],
            "{{#readings}}[{\"text\":\"{{parameter}}\", \"style\":\"value\"}, {\"text\":\"{{reading}}\", \"style\":\"value\"}, {\"text\":\"{{accepted}}\", \"style\":\"value\"}, {\"text\":\"{{result}}\", \"style\":\"value\"}]{{/readings}}"
          ]
        },
        "layout": {}
      },
      {
        "text": "Latest action",
        "style": "sectionHeader"
      },
      {
        "table": {
          "widths": [
            "18%",
            "32%",
            "18%",
            "32%"
          ],
          "body": [
            [
              {
                "text": "Action",
                "style": "label"
              },
              {
                "text": "{{step_action}}",
                "style": "value"
              },
              {
                "text": "By",
                "style": "label"
              },
              {
                "text": "{{step_by}}",
                "style": "value"
              }
            ],
            [
              {
                "text": "When",
                "style": "label"
              },
              {
                "text": "{{step_at}}",
                "style": "value"
              },
              {
                "text": "Reason / comment",
                "style": "label"
              },
              {
                "text": "{{step_comment}}",
                "style": "value"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "text": "Photos",
        "style": "sectionHeader"
      },
      {
        "table": {
          "headerRows": 1,
          "widths": [
            "70%",
            "30%"
          ],
          "body": [
            [
              {
                "text": "Photo type",
                "style": "tableHeader"
              },
              {
                "text": "Count",
                "style": "tableHeader"
              }
            ],
            "{{#documents}}[{\"text\":\"{{documentType}}\", \"style\":\"value\"}, {\"text\":\"{{count}}\", \"style\":\"value\"}]{{/documents}}"
          ]
        },
        "layout": {}
      },
      {
        "table": {
          "widths": [
            "50%",
            "50%"
          ],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Field staff with the end user and the system",
                    "style": "photoTitle"
                  },
                  {
                    "image": "{{photo_verification}}",
                    "fit": [
                      240,
                      180
                    ]
                  }
                ],
                "margin": [
                  0,
                  0,
                  0,
                  8
                ]
              },
              {
                "stack": [
                  {
                    "text": "Neutral to earth voltage, PCU output",
                    "style": "photoTitle"
                  },
                  {
                    "image": "{{photo_ne_pcu}}",
                    "fit": [
                      240,
                      180
                    ]
                  }
                ],
                "margin": [
                  0,
                  0,
                  0,
                  8
                ]
              }
            ],
            [
              {
                "stack": [
                  {
                    "text": "Neutral to earth voltage, grid input",
                    "style": "photoTitle"
                  },
                  {
                    "image": "{{photo_ne_grid}}",
                    "fit": [
                      240,
                      180
                    ]
                  }
                ],
                "margin": [
                  0,
                  0,
                  0,
                  8
                ]
              },
              {
                "stack": [
                  {
                    "text": "Solar SPD",
                    "style": "photoTitle"
                  },
                  {
                    "image": "{{photo_solar_spd}}",
                    "fit": [
                      240,
                      180
                    ]
                  }
                ],
                "margin": [
                  0,
                  0,
                  0,
                  8
                ]
              }
            ],
            [
              {
                "stack": [
                  {
                    "text": "Grid input SPD",
                    "style": "photoTitle"
                  },
                  {
                    "image": "{{photo_grid_spd}}",
                    "fit": [
                      240,
                      180
                    ]
                  }
                ],
                "margin": [
                  0,
                  0,
                  0,
                  8
                ]
              },
              {
                "text": ""
              }
            ]
          ]
        },
        "layout": "noBorders",
        "margin": [
          0,
          8,
          0,
          0
        ]
      }
    ],
    "styles": {
      "title": {
        "fontSize": 15,
        "bold": true,
        "alignment": "center",
        "margin": [
          0,
          0,
          0,
          2
        ]
      },
      "note": {
        "fontSize": 8,
        "italics": true,
        "color": "#666666",
        "alignment": "center",
        "margin": [
          0,
          0,
          0,
          8
        ]
      },
      "sectionHeader": {
        "fontSize": 11,
        "bold": true,
        "margin": [
          0,
          10,
          0,
          4
        ]
      },
      "tableHeader": {
        "fontSize": 9,
        "bold": true,
        "fillColor": "#EEEEEE"
      },
      "label": {
        "fontSize": 9,
        "bold": true
      },
      "value": {
        "fontSize": 9
      },
      "photoTitle": {
        "fontSize": 9,
        "bold": true,
        "margin": [
          0,
          4,
          0,
          2
        ]
      }
    }
  }
}
